# Kotha configuration.
# Copy to `.env.local` (git-ignored), fill in, then restart with `npx expo start --clear`.
#
# Two kinds of variables live here:
#   EXPO_PUBLIC_*  → compiled into the app bundle. Anyone with the app can read
#                    them. NEVER put an API key in an EXPO_PUBLIC_ variable.
#   everything else → only visible to the server code that runs on your laptop
#                    (Expo Router API routes in src/app/api). Keys go here.
# See docs/API_INTEGRATION.md.

# ---------------------------------------------------------------------------
# App (public)
# ---------------------------------------------------------------------------

# Sentence generation:
#   remote – the Kotha API (in development: the laptop's `npx expo start` server → Gemini)
#   mock   – offline rule-based Bangla generator, no network, no key
EXPO_PUBLIC_LLM_MODE=remote

# Text-to-speech:
#   device – the phone's own TTS via expo-speech (offline if a Bangla voice is installed)
#   mock   – no audio, only the speaking animation
#   remote – POST {api}/v1/tts on your own backend (not implemented by the dev server)
EXPO_PUBLIC_TTS_MODE=device

# Leave EMPTY during development: the app automatically calls the laptop that
# served the app (e.g. http://192.168.0.12:8081/api).
# Set it only when the API is hosted elsewhere, e.g. https://kotha-api.example.org/api
EXPO_PUBLIC_KOTHA_API_URL=

# Network timeout for API calls, in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Server only (read by src/app/api/*, never sent to the phone)
# ---------------------------------------------------------------------------

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (default: gemini-3.5-flash)
GEMINI_MODEL=
